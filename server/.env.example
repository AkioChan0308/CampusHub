# Chép file này thành .env rồi sửa. Không commit file .env.

# Cổng chạy máy chủ
PORT=4000

# demo: có thêm đăng nhập nhanh bằng tài khoản mẫu (POST /auth/dev-login) và header X-Demo-User, chỉ dùng khi phát triển.
# google: chỉ đăng nhập Google.
AUTH_MODE=demo

# Khóa bí mật để ký mã QR điểm danh. Bản thật bắt buộc đặt chuỗi ngẫu nhiên dài.
QR_SECRET=

# Địa chỉ của web (giao diện). Web chuyển tiếp /api/v1 sang máy chủ nên cookie đăng nhập thuộc địa chỉ này.
WEB_ORIGIN=http://localhost:3000

# Đăng nhập Google: tạo OAuth client (loại Web application) trên Google Cloud Console.
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
# Để trống thì trang đăng nhập không hiện nút Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Thử từng vai bằng tài khoản Google thật: email=mã người trong dữ liệu mẫu, cách nhau bằng dấu phẩy.
# Ví dụ: LOGIN_AS=ban@example.com=a001,banthan@example.com=a017 (a001 chủ nhiệm, a002 thủ quỹ, a017 thành viên; danh sách đủ ở docs/api.md).
# Email thật chỉ ghi ở .env, không ghi vào file nào được commit.
LOGIN_AS=

# ---------- PostgreSQL (hướng dẫn: ../docs/postgresql.md) ----------
# Để trống DATABASE_URL thì máy chủ giữ dữ liệu mẫu trong bộ nhớ như trước: tắt máy chủ là mất mọi thay đổi.

# Mật khẩu của PostgreSQL chạy bằng Docker (docker compose up -d đọc dòng này). Tự đặt, chỉ chữ và số cho dễ ghi vào DATABASE_URL.
POSTGRES_PASSWORD=
# Cổng của PostgreSQL trên máy này. Đổi khi cổng 5432 đã có chương trình khác dùng (nhớ đổi cả trong DATABASE_URL).
POSTGRES_PORT=5432

# Địa chỉ cơ sở dữ liệu. Với Docker: postgres://campushub:<mật khẩu ở trên>@localhost:5432/campushub
DATABASE_URL=

# ---------- Trợ lý cho bàn giao (tóm tắt, hỏi đáp trong kho) ----------
# mock: bản mẫu, tính từ dữ liệu của CLB, không gọi dịch vụ AI nào (mặc định). real: chưa nối; chọn nhà cung cấp và khóa API sau.
AI_MODE=mock
# Chỉ dùng khi AI_MODE=real: khóa tạo ở Google AI Studio (aistudio.google.com) và tên mô hình. Khóa chỉ để trong .env, không commit.
# Gọi lỗi hoặc hết hạn mức thì trợ lý lùi về bản mẫu. Đổi mô hình chỉ cần sửa AI_MODEL (xem hạn mức từng mô hình ở trang rate limit của AI Studio).
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Số lượt hỏi tối đa mỗi CLB mỗi học kỳ (bản miễn phí). Để trống hoặc 0 là không giới hạn: mức giới hạn chưa có.
AI_FREE_ASKS_PER_TERM=
