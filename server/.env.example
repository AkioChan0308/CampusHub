# Chép file này thành .env rồi sửa. Không commit file .env.

# Cổng chạy máy chủ
PORT=4000

# demo: có thêm đăng nhập nhanh bằng tài khoản mẫu (POST /auth/dev-login) và header X-Demo-User, chỉ dùng khi phát triển.
# google: chỉ đăng nhập Google.
AUTH_MODE=demo

# Khóa bí mật để ký mã QR điểm danh. Bản thật bắt buộc đặt chuỗi ngẫu nhiên dài.
QR_SECRET=

# Địa chỉ của web (giao diện). Web chuyển tiếp /api/v1 sang máy chủ nên cookie đăng nhập thuộc địa chỉ này.
WEB_ORIGIN=http://localhost:3000

# ---------- Đăng nhập Google (tùy chọn) ----------
# Hướng dẫn từng bước, có bảng lỗi thường gặp: ../docs/dang-nhap-google.md
# Tóm tắt: trên Google Cloud Console tạo OAuth client loại "Web application", thêm đúng một Authorized redirect URI:
#   http://localhost:3000/api/v1/auth/google/callback
# rồi thêm Gmail sẽ thử vào "Test users" của màn hình đồng ý (chế độ Testing, không cần Google duyệt). Web phải chạy ở cổng 3000.
# Mỗi người tự tạo khóa riêng; repo không có khóa. Client secret chỉ để ở file này, không dán vào nhóm chat, không commit.
# Để trống thì trang đăng nhập không hiện nút Google (tài khoản mẫu ở chế độ demo vẫn dùng được).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ghép Gmail thật với một người trong dữ liệu mẫu, để đăng nhập Google là vào đúng vai đó: email=mã người.
# Nhiều email thì nối trên CÙNG MỘT DÒNG, cách nhau bằng dấu phẩy (viết hai dòng LOGIN_AS riêng thì chỉ dòng cuối có tác dụng).
# Ví dụ: LOGIN_AS=ban@example.com=a001,banbe@example.com=a017
#   a001 chủ nhiệm, a002 thủ quỹ, a005 trưởng ban, a017 thành viên (chủ nhiệm mới khi bàn giao), p-thu-trang ban quản lý CLB của trường; danh sách đủ ở ../docs/api.md.
# Email không có ở đây thì được tạo thành tài khoản sinh viên mới, chưa ở CLB nào.
# Email thật chỉ ghi ở .env, không ghi vào file nào được commit.
# Sửa .env xong phải KHỞI ĐỘNG LẠI máy chủ (npm run dev trong server/) mới có tác dụng.
LOGIN_AS=

# ---------- PostgreSQL (hướng dẫn: ../docs/postgresql.md) ----------
# Để trống DATABASE_URL thì máy chủ giữ dữ liệu mẫu trong bộ nhớ như trước: tắt máy chủ là mất mọi thay đổi.

# Mật khẩu của PostgreSQL chạy bằng Docker (docker compose up -d đọc dòng này). Tự đặt, chỉ chữ và số cho dễ ghi vào DATABASE_URL.
POSTGRES_PASSWORD=
# Cổng của PostgreSQL trên máy này. Đổi khi cổng 5432 đã có chương trình khác dùng (nhớ đổi cả trong DATABASE_URL).
POSTGRES_PORT=5432

# Địa chỉ cơ sở dữ liệu. Với Docker: postgres://campushub:<mật khẩu ở trên>@localhost:5432/campushub
DATABASE_URL=

# ---------- Trợ lý cho bàn giao (tóm tắt, hỏi đáp trong kho) ----------
# mock: bản mẫu, tính từ dữ liệu của CLB, không gọi dịch vụ AI nào (mặc định). real: gọi Gemini (cần GEMINI_API_KEY bên dưới).
AI_MODE=mock
# Chỉ dùng khi AI_MODE=real: khóa tạo ở Google AI Studio (aistudio.google.com) và tên mô hình. Khóa chỉ để trong .env, không commit.
# Gọi lỗi hoặc hết hạn mức thì trợ lý lùi về bản mẫu. Đổi mô hình chỉ cần sửa AI_MODEL (xem hạn mức từng mô hình ở trang rate limit của AI Studio).
GEMINI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Chỉ để quay video demo (chế độ AUTH_MODE=demo): đồng hồ máy chủ đi từ thời điểm này, ví dụ 2026-10-03T09:00:00+07:00. Để trống là dùng giờ thật.
DEMO_NOW=
# Cầu chì: số lần gọi Gemini tối đa của cả hệ thống trong 24 giờ. Mặc định 400 (hạn mức miễn phí của gemini-3.1-flash-lite là 500). 0 là không giới hạn. Vượt thì dùng bản mẫu.
AI_DAILY_CAP=
# Số lượt hỏi tối đa mỗi CLB mỗi học kỳ (bản miễn phí). Để trống hoặc 0 là không giới hạn: dùng cho bản demo (mở hết tính năng).
# Bản chính thức: đặt 10 (nhóm chốt 30/10/2026; con số tự chọn, chưa có dữ liệu dùng thật). Gói trả phí không giới hạn (chưa có cờ gói theo CLB).
AI_FREE_ASKS_PER_TERM=
